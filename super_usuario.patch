+def _migrar_usuario():
+    """Bancos criados antes do super usuário não têm a coluna `superusuario`: adiciona."""
+    with transacao() as con:
+        colunas = [linha["name"] for linha in con.execute("PRAGMA table_info(usuario)")]
+        if "superusuario" not in colunas:
+            con.execute(
