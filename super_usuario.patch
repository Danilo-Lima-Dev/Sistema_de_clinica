+        raise ErroValidacao("Você não pode excluir o seu próprio usuário.")
+    with database.transacao() as con:
+        alvo = con.execute(
+            "SELECT superusuario, ativo FROM usuario WHERE id = ?", (id_usuario,)
+        ).fetchone()
+        if alvo is None:
